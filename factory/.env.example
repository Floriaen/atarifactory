# Copy to .env and fill in.

# ── Pipeline service (the only process that calls Claude) ────────────────────
# Needed for the live e2e (make test-e2e) and any real run.
ANTHROPIC_API_KEY=
# Or route through the local Claude Code subscription instead of the metered API:
# PROVIDER=claude-code
# PORT=8910                 # pipeline service port (default 8910)

# ── Admin server (a pure client of the pipeline — needs NO API key) ──────────
# ADMIN_PORT=8787
# PIPELINE_URL=http://127.0.0.1:8910
# Shared bearer token between the admin and the pipeline (the pipeline triggers billable calls):
# PIPELINE_TOKEN=
