{
  "name": "game-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "contracts"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "view-run": "tsx bin/view-run.ts",
    "batch": "tsx bin/batch-design.ts",
    "art": "tsx bin/art.ts",
    "code": "tsx bin/code.ts",
    "play": "tsx bin/play.ts",
    "serve": "tsx watch bin/serve.ts",
    "admin:server": "tsx watch admin/server/index.ts",
    "admin:web": "vite admin/web",
    "admin:build": "vite build admin/web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@game-factory/contracts": "*",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.13.0",
    "express": "^4.22.2",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
